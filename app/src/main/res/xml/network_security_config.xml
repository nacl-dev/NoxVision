<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
       Explicitly allow cleartext traffic for the camera's default IP.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">192.168.42.1</domain>
    </domain-config>

    <!--
       ENFORCE HTTPS for external APIs to prevent MITM attacks.
       Even if the code tries to use HTTP, the system will block it.
    -->
    <domain-config cleartextTrafficPermitted="false">
        <domain includeSubdomains="true">openweathermap.org</domain>
    </domain-config>

    <!--
       Disable cleartext traffic by default; only explicitly whitelisted domains
       (such as the local camera IP above) may use cleartext HTTP.
       This enforces HTTPS for external/public hosts by default.
    -->
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
